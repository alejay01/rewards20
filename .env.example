# Server Configurations
NODE_ENV=production
PORT=3000
APP_URL=https://theboudincompany.com
CLIENT_URL=https://theboudincompany.com

# Database Connection (MySQL Production & XAMPP Local)
# You can supply either a full connection URL or individual MYSQL parameters
DATABASE_URL=mysql://root:@127.0.0.1:3306/rewards20
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rewards20
MYSQL_USER=root
MYSQL_PASSWORD=

# Session & Token Secrets
SESSION_SECRET=replace-with-a-unique-random-secret
JWT_SECRET=replace-with-a-different-unique-random-secret
QR_TOKEN_SECRET=replace-with-another-unique-random-secret

# Loyverse API Integration
LOYVERSE_API_KEY=
LOYVERSE_API_BASE_URL=https://api.loyverse.com/v1.0
LOYVERSE_DEMO_MODE=true

# Twilio SMS (safe by default: dry-run does not contact Twilio)
SMS_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://theboudincompany.com
TWILIO_VALIDATE_SIGNATURES=true

# SMS compliance and sending safeguards
SMS_MAX_RECIPIENTS_PER_RUN=50
SMS_TIMEZONE=America/Chicago
SMS_ENFORCE_QUIET_HOURS=true
SMS_SEND_WINDOW_START=9
SMS_SEND_WINDOW_END=20
SMS_VIP_SPEND_THRESHOLD=100
